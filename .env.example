# Environment variables for PyAntiSpam
# Copy to .env and fill in your credentials. Never commit .env.

# LLM API key, matching llm.provider in config.yaml
MISTRAL_API_KEY=your-mistral-key-here
# OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Email account passwords (one per password_env in config.yaml)
EMAIL_PASSWORD_PERSONAL=your-email-password
# EMAIL_PASSWORD_WORK=your-work-email-password

# rspamd controller password (config.yaml: rspamd.enabled)
# RSPAMD_PASSWORD=your-rspamd-controller-password
