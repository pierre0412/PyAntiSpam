# PyAntiSpam Configuration Example
# Copy to config.yaml and customize. Secrets go in .env, never here.

# LLM used for uncertain cases (RF below ml_confidence_threshold).
# The API key is read from the matching environment variable:
# MISTRAL_API_KEY, OPENAI_API_KEY or ANTHROPIC_API_KEY.
llm:
  provider: "mistral"              # mistral, openai, anthropic
  model: "mistral-large-4"         # e.g. "gpt-4o-mini" (openai), "claude-3-haiku-20240307" (anthropic)
                                   # Name Large 4 explicitly: mistral-large-latest still points to Large 3.
  reasoning_effort: "none"         # Mistral reasoning models: "none" answers directly (fast, cheap),
                                   # "high" thinks first (~25 s, ~6x the cost). Omit for other models.
  # Mistral + rspamd only. Give the LLM the recipient's own verdicts on the sender's domain
  # (counts capped at 10), only when rspamd verified the sender: a spoofed From inherits nothing.
  recipient_history: false
  # Shadow mode: re-ask the LLM with Auth=verified, the history and up to 5 earlier emails
  # from the sender that the recipient labelled. Logged to data/logs/llm_context_shadow_log.jsonl,
  # never acted on.
  context_shadow: false

  # Cache of LLM verdicts and of user feedback overrides (data/llm_cache.json)
  cache:
    enabled: true
    file_path: "data/llm_cache.json"
    max_age_days: 30               # Ignore entries older than N days (0 = never)

# Email Accounts Configuration
email_accounts:
  - name: "personal"
    server: "imap.gmail.com"
    port: 993
    username: "your-email@gmail.com"
    password_env: "EMAIL_PASSWORD_PERSONAL"
    use_ssl: true
    # spam_folder: "Junk"          # Account-specific spam folder (default: actions.move_spam_to_folder)

  # - name: "work"
  #   server: "outlook.office365.com"
  #   port: 993
  #   username: "your-work@company.com"
  #   password_env: "EMAIL_PASSWORD_WORK"
  #   use_ssl: true

# Spam Detection Settings
detection:
  ml_confidence_threshold: 0.8     # RF decides alone above this confidence, else the LLM is asked
  use_llm_for_uncertain: true      # false: uncertain emails are kept
  classify_marketing_as_spam: false     # Hand-written marketing rule (fixed weights, never learned).
  marketing_confidence_threshold: 0.6   # Disabled by default: it misfiled supplier mails as spam.
  lookalike_shadow: true           # Log senders imitating a domain you validated (lookalike_shadow_log.jsonl), never acts.

# Whitelist / blacklist (data/whitelist.json, data/blacklist.json)
lists:
  shadow: false                    # true: list verdicts are only logged, the models decide.
                                   # Useful while the models learn: list hits otherwise hide
                                   # their mistakes from the user's corrections.

# Learning: the models learn only from the user's reclassifications (feedback folders).
learning:
  retrain_threshold: 10            # Retrain the RF on the full history after N reclassifications
  auto_blacklist_threshold: 3      # Add sender to blacklist after N "is spam" reclassifications
  auto_whitelist_threshold: 3      # Add sender to whitelist after N "not spam" reclassifications
  tacit_confirmation_days: 0       # > 0: an LLM spam verdict not moved to PYANTISPAM_NOT_SPAM
                                   # within this many days (left in the spam folder or deleted)
                                   # is learned as spam. 0 = off: only explicit reclassifications.

# Feedback folders (fixed names, created automatically in each account):
# - PYANTISPAM_IS_SPAM      a spam that was kept: learned as spam, moved to the spam folder
# - PYANTISPAM_NOT_SPAM     a legitimate mail filed as spam: learned as ham, moved back to INBOX
# - PYANTISPAM_WHITELIST    adds the sender to the whitelist, moved to INBOX
# - PYANTISPAM_BLACKLIST    adds the sender to the blacklist, moved to the spam folder

# Action Settings
actions:
  move_spam_to_folder: "SPAM_AUTO" # Default spam folder (per account: spam_folder)
  auto_delete_after_days: 0        # Delete spam older than N days (0 = never, recommended)

# Email Connection Settings
email_connection:
  request_delay: 0.1               # Delay between IMAP requests in seconds
  timeout: 10                      # IMAP timeout in seconds

# Shadow mode ("mode fantôme"): scored and logged next to the real decision,
# never acting on the mail. See shadow_report.py and live_eval.py.
embeddings:
  enabled: false
  model: "dangvantuan/sentence-camembert-base"

rspamd:
  enabled: false
  url: "http://rspamd:11334"       # Docker service name (docker-compose.yml)
  password_env: "RSPAMD_PASSWORD"
  timeout: 10                      # Seconds; a slow rspamd never blocks mail processing
  # Your mail hosts' relay domains. The connecting IP is read from the Received
  # headers they wrote (never from those below, which the sender can forge) and
  # given to rspamd so it can check SPF. Empty: no IP, SPF stays unchecked.
  trusted_relays: []               # e.g. ["o2switch.net", "free.fr", "proxad.net"]

logging:
  # System log (all events)
  system:
    enabled: true
    file_path: "data/logs/pyantispam.log"
    max_size_mb: 10                # Rotate at this size
    backup_count: 5                # Number of rotated files kept
    console_level: "INFO"
    file_level: "DEBUG"

  # Spam decisions only
  decisions:
    enabled: true
    file_path: "data/logs/spam_decisions.log"
    max_size_mb: 20
    backup_count: 10
